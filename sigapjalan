  try{if(fi){nama=fi.name;if(/\.kmz$/i.test(nama)){const z=await JSZip.loadAsync(fi),k=Object.keys(z.files).find(n=>/\.kml$/i.test(n));if(!k)return{error:'KMZ tidak berisi file .kml'};t=await z.files[k].async('string');fmt='KMZ'}else t=await fi.text();orig=await b64(fi)}
   if(!t)return{error:'Isi geometri atau pilih file'};let gj;if(t.trim().startsWith('{')){gj=JSON.parse(t);fmt=fmt||'GeoJSON'}else{gj=kml2gj(t);fmt=fmt||'KML'}
   const row={id:uid('G'),projectId:v.projectId,nama,format:fmt,tipe:(gj.features?gj.features[0].geometry:gj.geometry||gj).type,geojson:JSON.stringify(gj),jenis:v.jenis,panjangKm:+lenKm(gj).toFixed(3)};
   if(OFF)return save('Geometri_Peta',row);
   const r=await post({action:'saveGeo',row,orig});if(r.auth===false){SES=null;loginUI('Sesi berakhir')}if(r.ok)await load();return r
  }catch(e){return{error:'Geometri tidak valid: '+e.message}}})}
/* ===== DETAIL ===== */
function detail(id){const p=DB.Proyek.find(x=>x.id===id),c=calc(p);map&&0;const W=Math.max(0,...Object.keys(c.plan).map(Number)),P=[...Array(W)].map((_,i)=>c.pa(i+1)),R=[...Array(W)].map((_,i)=>c.lastW&&i+1<=c.lastW?c.ra(i+1):null);
 $('#mbox').innerHTML=`<h2>${esc(p.nama)}</h2><div class="sub">${p.id} · TA ${p.tahun} · ${p.kecamatan} · ${esc(p.lokasi)} · ${p.jenis} · ${p.sumber}</div><p>Penyedia: ${esc(p.penyedia)||'–'} · PPK: ${esc(p.ppk)||'–'} · PPTK: ${esc(p.pptk)||'–'} · Pengawas: ${esc(p.pengawas)||'–'}<br>Kontrak ${rp(+p.kontrak)} · Pagu ${rp(+p.pagu)} · ${p.mulai||'?'} s/d ${p.selesai||'?'}<br>Fisik ${pc(c.phys)} · Keuangan ${pc(c.finPct)} (${rp(c.paid)}) · Sisa kontrak ${rp(c.sisa)} · <span class="b ${cls(c.st)}">${c.st}</span></p>${W?lineChart(W,[{n:'Rencana',c:'#d93a3a',v:P},{n:'Realisasi',c:'#1f5fd1',v:R}]):'<div class="sub">Jadwal belum ada</div>'}<h2>Riwayat</h2>${DB.Monitoring_Mingguan.filter(m=>m.projectId===id).map(m=>`<div class="sub">M${m.minggu}: ${m.real}% — ${esc(m.kendala)||'tanpa kendala'} (${(m.updated||'').slice(0,10)})</div>`).join('')||'<div class="sub">Belum ada monitoring</div>'}<div class="row" style="margin-top:12px"><button class="btn g" onclick="closeM()">Tutup</button></div>`;$('#modal').style.display='flex'}
/* ===== PERAN, SORTIR, PAGINATION ===== */
const TS={};
function enh(){
 document.querySelectorAll('#main button').forEach(b=>{const t=b.textContent.trim();if(!/^(\+|Edit|Arsip|Ubah|Hapus)/.test(t))return;
  const ok=ROLE==='admin'||(ROLE==='editor'&&t!=='Hapus')||(ROLE==='pengawas'&&page===2&&!/^(Hapus|Arsip)/.test(t));if(!ok)b.remove()});
 document.querySelectorAll('#main table').forEach((t,ti)=>{
  if(t.style.minWidth==='0px'||t.rows.length<3)return;
  const S=TS[ti]=TS[ti]||{c:-1,d:1,p:0,n:10},all=[...t.rows],hd=all[0],rows=all.slice(1),tb=hd.parentElement;
  const val=r=>{const x=(r.cells[S.c]?.textContent||'').trim();if(x===''||x==='–')return null;if(/^\d{4}-\d\d-\d\d/.test(x))return x;const y=x.replace(/^Rp/,'').replace(/%$/,'').replace('−','-');if(/^Rp/.test(x))return +y.replace(/\./g,'')||0;return /^[+-]?\d+(\.\d+)?$/.test(y)?+y:x.toLowerCase()};
  if(S.c>=0)rows.sort((a,b)=>{const x=val(a),y=val(b);if(x==null)return 1;if(y==null)return -1;return(x>y?1:x<y?-1:0)*S.d});
  rows.forEach(r=>tb.appendChild(r));const pg=Math.ceil(rows.length/S.n);S.p=Math.max(0,Math.min(S.p,pg-1));
  rows.forEach((r,i)=>r.style.display=i>=S.p*S.n&&i<(S.p+1)*S.n?'':'none');
  [...hd.cells].forEach((h,i)=>{h.style.cursor='pointer';h.title='Klik untuk mengurutkan';h.textContent=h.textContent.replace(/ [▲▼]$/,'')+(S.c===i?(S.d>0?' ▲':' ▼'):'');h.onclick=()=>{S.d=S.c===i?-S.d:1;S.c=i;enh()}});
  if(t.nextElementSibling&&t.nextElementSibling.classList.contains('pgr'))t.nextElementSibling.remove();
  if(rows.length>10){const d=document.createElement('div');d.className='row pgr';d.innerHTML=`<button class="btn s g" ${S.p?'':'disabled'}>‹</button><span class="sub">Hal ${S.p+1}/${pg} · ${rows.length} baris</span><button class="btn s g" ${S.p<pg-1?'':'disabled'}>›</button><select>${[10,25,50].map(n=>`<option ${n==S.n?'selected':''}>${n}</option>`).join('')}</select>`;
   const c=d.children;c[0].onclick=()=>{S.p--;enh()};c[2].onclick=()=>{S.p++;enh()};c[3].onchange=e=>{S.n=+e.target.value;S.p=0;enh()};t.after(d)}})}
/* ===== ROUTER ===== */
function go(){
 $('#nav').innerHTML=PAGES.map((n,i)=>`<a class="${i==page?'on':''}" onclick="page=${i};go();$('#sb').classList.remove('open')">${['📊','📁','🗓','📈','💰','🗺'][i]} ${n}</a>`).join('');$('#ttl').textContent=PAGES[page]+' · SIGAP JALAN';
 const ys=[...new Set(DB.Proyek.map(p=>String(p.tahun)))].sort();$('#ta').innerHTML='<option value="">Semua</option>'+ys.map(y=>`<option ${y==F.tahun?'selected':''}>${y}</option>`).join('');
 $('#sync').textContent=lastSync?'Sinkron '+lastSync.toLocaleTimeString('id-ID'):'';
 $('#main').innerHTML=(OFF?'<div class="demo">Belum terhubung ke Google Spreadsheet (CFG.API_URL kosong). Perubahan hanya tersimpan sementara di browser.</div>':'')+[pDash,pProyek,pMon,pSch,pKeu,pPeta][page]();enh()}
setInterval(()=>{if($('#modal').style.display!=='flex'&&!OFF&&SES)load()},CFG.POLL_MS);
load();

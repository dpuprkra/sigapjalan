<style>
:root{--nv:#14306b;--bl:#1f5fd1;--bg:#eef2f8;--cd:#fff;--tx:#1b2433;--mu:#6b7686;--bd:#dbe2ee;--ok:#12975a;--wr:#e0a100;--er:#d93a3a}
@media(prefers-color-scheme:dark){:root{--bg:#0f1624;--cd:#18213a;--tx:#e8edf7;--mu:#98a3b8;--bd:#2a3555}}
*{box-sizing:border-box}body{margin:0;font:14px system-ui,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--tx);display:flex;min-height:100vh}
#sb{width:230px;background:var(--nv);color:#fff;padding:14px 10px;flex:none;transition:.2s}#sb.min{width:0;padding:0;overflow:hidden}

.k{color:var(--mu);font-size:12px}.v{font-size:20px;font-weight:700;margin-top:4px}.sub{font-size:11px;color:var(--mu)}
h2{margin:0 0 10px;font-size:15px}.row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center}
select,input,textarea{padding:7px;border:1px solid var(--bd);border-radius:6px;background:var(--cd);color:var(--tx);font:inherit;max-width:100%}
.btn{background:var(--bl);color:#fff;border:0;border-radius:6px;padding:8px 12px;cursor:pointer}.btn.g{background:transparent;color:var(--bl);border:1px solid var(--bl)}.btn.s{padding:3px 8px;font-size:12px}
table{border-collapse:collapse;width:100%;min-width:640px}th{background:var(--bl);color:#fff;text-align:left;padding:7px;font-size:12px}td{padding:7px;border-bottom:1px solid var(--bd);vertical-align:top}

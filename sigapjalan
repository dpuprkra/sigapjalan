  if(pts.some(p=>p[0]<-180||p[0]>180||p[1]<-90||p[1]>90))throw new Error('Koordinat di luar rentang WGS84');
  if(pts.length)F.push({type:'Feature',properties:{},geometry:c.parentElement.tagName==='Point'?{type:'Point',coordinates:pts[0]}:{type:'LineString',coordinates:pts}})})});

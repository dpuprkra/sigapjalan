</style></head><body>
<nav id="sb"><h1>SIGAP JALAN</h1><small>Sistem Pengendalian Rehabilitasi Jalan · DPUPR Kab. Karanganyar</small><div id="nav"></div></nav>
<div id="mn"><header><button onclick="tg()">☰</button><b id="ttl"></b><span class="sp"></span><span>TA <select id="ta" onchange="F.tahun=this.value;go()"></select></span><span id="sync"></span><button onclick="load()">⟳</button><button onclick="akun()">👤 Akun</button></header>
<main id="main"></main></div>
<div id="modal"><div class="box" id="mbox"></div></div><div id="toast"></div>
<script>
/* ===== KONFIGURASI ===== */
const CFG={API_URL:'https://script.google.com/macros/s/AKfycbzCDy-idiu3alGYFTigf_5jIV2Qd4z2FqsYo9JviIxypADUZWkFeVlhbysPMAl3w-H8LQ/exec',            // tempel URL Web App Apps Script (…/exec). Kosong = MODE DEMO
 POLL_MS:45000, WARN:2, LATE:5,   // status: deviasi < -WARN = Perlu Perhatian, < -LATE = Terlambat (poin %)
 STALE_DAYS:10, LOW_PAY:50};      // peringatan: monitoring tidak diperbarui, realisasi keuangan rendah (%)
const PAGES=['Dashboard','Proyek','Monitoring Mingguan','Time Schedule','Keuangan','Peta Proyek'];
const KEC=['Colomadu','Gondangrejo','Jaten','Jatipuro','Jatiyoso','Jenawi','Jumantono','Jumapolo','Karanganyar','Karangpandan','Kebakkramat','Matesih','Mojogedang','Ngargoyoso','Tasikmadu','Tawangmangu','Kerjo'];
const JENIS={'Aspal Jalan':'#12975a','Beton Jalan':'#e0a100','Jembatan':'#d93a3a','Drainase':'#1f5fd1'};
const SUMBER=['APBD','DAK','DBHCHT','Lainnya'];
let DB={Proyek:[],Monitoring_Mingguan:[],Time_Schedule:[],Keuangan:[],Geometri_Peta:[]},OFF=!CFG.API_URL,page=0,F={tahun:'',kec:'',jenis:'',sumber:'',status:'',q:'',curve:''},lastSync=null,map=null;
/* ===== UTIL ===== */
const $=s=>document.querySelector(s),tm=()=>new Date().toISOString(),N=x=>(x===''||x==null||isNaN(+x))?null:+x;
const rp=n=>n==null?'–':'Rp'+Math.round(n).toLocaleString('id-ID'),pc=v=>v==null?'–':v.toFixed(1)+'%';
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const uid=p=>p+'-'+Date.now().toString(36)+Math.random().toString(36).slice(2,5);
let SES=null,ROLE='',USER='';try{SES=localStorage.getItem('sj_ses')}catch(e){}
function toast(m,e){const d=document.createElement('div');d.textContent=m;if(e)d.className='e';$('#toast').append(d);setTimeout(()=>d.remove(),4500)}
function tg(){const s=$('#sb');innerWidth<761?s.classList.toggle('open'):s.classList.toggle('min')}
/* ===== API & AKUN ===== */
async function post(b){if(OFF)return{ok:true};try{return await(await fetch(CFG.API_URL,{method:'POST',headers:{'Content-Type':'text/plain'},body:JSON.stringify({...b,token:SES})})).json()}catch(e){return{ok:false,error:'Jaringan: '+e.message}}}
function loginUI(m){$('#mbox').innerHTML=`<h2>Masuk SIGAP JALAN</h2>${m?`<div class="sub" style="color:var(--er);margin-bottom:8px">${esc(m)}</div>`:''}<div class="f"><label>Username</label><input id="lu"></div><div class="f"><label>Password</label><input id="lp" type="password" onkeydown="if(event.key==='Enter')doLogin()"></div><button class="btn" onclick="doLogin()">Masuk</button>`;$('#modal').style.display='flex'}
async function doLogin(){const r=await post({action:'login',username:$('#lu').value.trim(),password:$('#lp').value});if(!r.ok)return loginUI(r.error);SES=r.session;try{localStorage.setItem('sj_ses',SES)}catch(e){}closeM();load()}
function logout(){SES=null;ROLE='';try{localStorage.removeItem('sj_ses')}catch(e){}loginUI()}
function akun(){$('#mbox').innerHTML=`<h2>${esc(USER)} <span class="sub">(${ROLE})</span></h2><div class="row">${ROLE==='admin'?'<button class="btn" onclick="formUser()">+ Tambah/Ubah Pengguna</button>':''}<button class="btn g" onclick="logout()">Keluar</button><button class="btn g" onclick="closeM()">Tutup</button></div>`;$('#modal').style.display='flex'}
function formUser(){form('Pengguna (admin)',[{n:'username',l:'Username',r:1},{n:'nama',l:'Nama lengkap',r:1},{n:'role',l:'Peran',t:'select',o:['admin','editor','pengawas','viewer']},{n:'password',l:'Password (min 8; kosongkan bila tidak diubah)',t:'password'},{n:'aktif',l:'Aktif (1) / Nonaktif (0)',t:'select',o:['1','0']}],async v=>{if(v.password&&v.password.length<8)return{error:'Password minimal 8 karakter'};return post({action:'setUser',user:v})})}
async function load(){
 if(OFF){ROLE='admin';USER='Lokal';lastSync=new Date();return go()}
 if(!SES)return loginUI();
 try{const r=await(await fetch(CFG.API_URL+'?action=all&token='+encodeURIComponent(SES)+'&_='+Date.now())).json();
  if(r.auth===false){SES=null;return loginUI('Sesi berakhir, silakan masuk lagi')}
  if(!r.ok)throw new Error(r.error);DB=r.data;ROLE=r.role;USER=r.nama;lastSync=new Date();go()}catch(e){toast('Sinkronisasi gagal: '+e.message,1);$('#sync').textContent='⚠ gagal sinkron'}}
async function save(sheet,row,ver){
 row.updated=tm();
 if(OFF){const a=DB[sheet],i=a.findIndex(x=>x.id===row.id);i>=0?Object.assign(a[i],row):a.push(row);return{ok:true}}
 const r=await post({action:'upsert',sheet,row,ver});if(r.auth===false){SES=null;loginUI('Sesi berakhir')}if(r.ok)await load();return r}
const b64=f=>new Promise(r=>{const x=new FileReader();x.onload=()=>r(x.result.split(',')[1]);x.readAsDataURL(f)});
const shrink=f=>new Promise((res,rej)=>{const im=new Image();im.onerror=()=>rej(new Error('File bukan gambar'));im.onload=()=>{const s=Math.min(1,1280/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*s;c.height=im.height*s;c.getContext('2d').drawImage(im,0,0,c.width,c.height);res(c.toDataURL('image/jpeg',.8).split(',')[1])};im.src=URL.createObjectURL(f)});
async function upFoto(f){if(!/^image\//.test(f.type))return{ok:false,error:'Hanya file gambar'};if(OFF)return{ok:true,url:URL.createObjectURL(f)};
 try{return await post({action:'upload',name:f.name.replace(/\.\w+$/,'')+'.jpg',mime:'image/jpeg',data:await shrink(f)})}catch(e){return{ok:false,error:e.message}}}
async function hapus(id){if(!confirm('HAPUS PERMANEN proyek beserta seluruh data terkait? Tidak dapat dibatalkan.'))return;if(prompt('Ketik HAPUS untuk konfirmasi')!=='HAPUS')return;
 if(OFF){Object.keys(DB).forEach(k=>DB[k]=DB[k].filter(x=>k==='Proyek'?x.id!==id:x.projectId!==id));return go()}
 const r=await post({action:'delete',sheet:'Proyek',id});r.ok?(toast('Dihapus'),load()):toast(r.error,1)}
/* ===== PERHITUNGAN (satu sumber untuk kartu, tabel, grafik) ===== */
const byP=(sh,id)=>DB[sh].filter(x=>x.projectId===id);
function calc(p){
 const sch=byP('Time_Schedule',p.id).sort((a,b)=>a.minggu-b.minggu),mon=byP('Monitoring_Mingguan',p.id).sort((a,b)=>a.minggu-b.minggu);
 let c=0;const plan={};sch.forEach(s=>{c+=+s.bobot||0;plan[s.minggu]=c});
 c=0;const real={};mon.forEach(m=>{c+=+m.real||0;real[m.minggu]=c});
 const pa=w=>{let r=null;for(const k of Object.keys(plan).map(Number).sort((a,b)=>a-b)){if(k<=w)r=plan[k]}return r};
 const ra=w=>{let r=null;for(const k of Object.keys(real).map(Number).sort((a,b)=>a-b)){if(k<=w)r=real[k]}return r};
 const lastW=mon.length?mon[mon.length-1].minggu:null,phys=lastW?real[lastW]:null,pl=lastW?pa(lastW):null,dev=(phys!=null&&pl!=null)?phys-pl:null;
 const kts=DB.Keuangan.filter(k=>k.projectId===p.id&&k.status!=='Batal'),paid=kts.reduce((s,k)=>s+(+k.nilai||0),0),ret=kts.reduce((s,k)=>s+(+k.retensi||0),0),kon=+p.kontrak||null;
 let st='Belum Ada Data';
 if(phys!=null){st=phys>=100?'Selesai':dev!=null&&dev<-CFG.LATE?'Terlambat':dev!=null&&dev<-CFG.WARN?'Perlu Perhatian':'On Track';
  if(phys<100&&p.selesai&&new Date(p.selesai)<new Date())st='Terlambat'}
 const lastUpd=[p.updated,...mon.map(m=>m.updated),...kts.map(k=>k.updated)].filter(Boolean).sort().pop();
 return{plan,real,pa,ra,lastW,phys,pl,dev,paid,ret,kon,finPct:kon?paid/kon*100:null,sisa:kon!=null?kon-paid:null,st,lastUpd,nsch:sch.length,lastMon:mon.length?(mon[mon.length-1].tglAkhir||mon[mon.length-1].updated):null}}
const cls=s=>s==='On Track'||s==='Selesai'?'On':s==='Terlambat'?'Te':s==='Perlu Perhatian'?'Pe':'Ot';
const active=()=>DB.Proyek.filter(p=>p.arsip!=='1'&&p.arsip!==1);
function flt(){return active().filter(p=>(!F.tahun||String(p.tahun)===F.tahun)&&(!F.kec||p.kecamatan===F.kec)&&(!F.jenis||p.jenis===F.jenis)&&(!F.sumber||p.sumber===F.sumber)).map(p=>({p,c:calc(p)})).filter(x=>(!F.status||x.c.st===F.status)&&(!F.q||(x.p.nama+x.p.lokasi+x.p.kecamatan+x.p.id).toLowerCase().includes(F.q.toLowerCase())))}
/* Kurva S agregat: rata-rata TERBOBOT nilai kontrak; realisasi di-carry-forward per proyek, tidak dianggap 0 */
function curve(list){
 const L=list.filter(x=>x.c.nsch),W=Math.max(0,...L.map(x=>Math.max(...Object.keys(x.c.plan).map(Number))));
 const maxReal=Math.max(0,...L.map(x=>x.c.lastW||0)),P=[],R=[];
 for(let w=1;w<=W;w++){let sp=0,wp=0,sr=0,wr=0;L.forEach(x=>{const k=+x.p.kontrak||1,a=x.c.pa(w);if(a!=null){sp+=k*Math.min(a,100);wp+=k}
  if(w<=x.c.lastW||(w<=maxReal&&x.c.lastW)){const r=x.c.ra(Math.min(w,x.c.lastW));if(r!=null){sr+=k*r;wr+=k}}});
  P.push(wp?sp/wp:null);R.push(w<=maxReal&&wr?sr/wr:null)}
 return{W,P,R}}
/* ===== KOMPONEN ===== */
function lineChart(W,series){
 const w=640,h=250,l=36,b=24,X=i=>l+(W<2?0:i*(w-l-10)/(W-1)),Y=v=>h-b-v*(h-b-10)/100;let s=`<svg viewBox="0 0 ${w} ${h}" width="100%">`;
 for(let g=0;g<=100;g+=25)s+=`<line x1="${l}" x2="${w-10}" y1="${Y(g)}" y2="${Y(g)}" stroke="var(--bd)"/><text x="2" y="${Y(g)+3}">${g}%</text>`;
 for(let i=0;i<W;i++)if(W<16||i%2==0)s+=`<text x="${X(i)-6}" y="${h-8}">M${i+1}</text>`;
 series.forEach(se=>{let d='',pen=false;se.v.forEach((v,i)=>{if(v==null){pen=false;return}d+=(pen?'L':'M')+X(i)+','+Y(v);pen=true;});
  s+=`<path d="${d}" fill="none" stroke="${se.c}" stroke-width="2.5"/>`;se.v.forEach((v,i)=>{if(v!=null)s+=`<circle cx="${X(i)}" cy="${Y(v)}" r="3" fill="${se.c}"><title>${se.n} M${i+1}: ${v.toFixed(2)}%</title></circle>`})});
 return s+`</svg><div class="sub"><b style="color:#d93a3a">●</b> Rencana kumulatif &nbsp; <b style="color:#1f5fd1">●</b> Realisasi kumulatif</div>`}
const barRows=(rows,fmt)=>{const m=Math.max(1,...rows.map(r=>r[1]));return rows.map(r=>`<div style="margin:6px 0"><div class="sub">${esc(r[0])} — ${fmt(r[1])}</div><div class="bar"><i style="width:${r[1]/m*100}%"></i></div></div>`).join('')||'<div class="sub">Tidak ada data</div>'};
const sel=(id,opts,val,cb,ph)=>`<select onchange="${cb}">${[['',ph],...opts.map(o=>[o,o])].map(o=>`<option value="${esc(o[0])}" ${o[0]==val?'selected':''}>${esc(o[1])}</option>`).join('')}</select>`;
const card=(k,v,s)=>`<div class="card"><div class="k">${k}</div><div class="v">${v}</div>${s?`<div class="sub">${s}</div>`:''}</div>`;
const csv=(name,rows)=>{const t=rows.map(r=>r.map(c=>'"'+String(c??'').replace(/"/g,'""')+'"').join(',')).join('\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+t],{type:'text/csv'}));a.download=name;a.click()};
function filters(){return `<div class="row">${sel('',[...new Set(DB.Proyek.map(p=>String(p.tahun)))],F.tahun,"F.tahun=this.value;go()",'Semua TA')}${sel('',KEC,F.kec,"F.kec=this.value;go()",'Semua Kecamatan')}${sel('',Object.keys(JENIS),F.jenis,"F.jenis=this.value;go()",'Semua Jenis')}${sel('',SUMBER,F.sumber,"F.sumber=this.value;go()",'Semua Sumber')}${sel('',['On Track','Perlu Perhatian','Terlambat','Selesai','Belum Ada Data'],F.status,"F.status=this.value;go()",'Semua Status')}<input placeholder="Cari…" value="${esc(F.q)}" oninput="F.q=this.value;clearTimeout(window._t);window._t=setTimeout(go,300)"><button class="btn g" onclick="F={tahun:'',kec:'',jenis:'',sumber:'',status:'',q:'',curve:F.curve};go()">Reset filter</button></div>`}
/* ===== HALAMAN ===== */
function projTable(list,extra){return `<table><tr><th>No</th><th>Nama Proyek</th><th>Kecamatan</th><th>Jenis</th><th>Nilai Kontrak</th><th>Fisik</th><th>Keuangan</th><th>Deviasi</th><th>Status</th><th>Update</th><th></th></tr>${list.map((x,i)=>`<tr><td>${i+1}</td><td>${esc(x.p.nama)}</td><td>${esc(x.p.kecamatan)}</td><td>${esc(x.p.jenis)}</td><td>${rp(+x.p.kontrak)}</td><td>${pc(x.c.phys)}</td><td>${pc(x.c.finPct)}</td><td>${x.c.dev==null?'–':(x.c.dev>0?'+':'')+x.c.dev.toFixed(1)+'%'}</td><td><span class="b ${cls(x.c.st)}">${x.c.st}</span></td><td>${(x.c.lastUpd||'').slice(0,10)}</td><td><button class="btn s" onclick="detail('${x.p.id}')">Detail</button></td></tr>`).join('')||'<tr><td colspan=11>Tidak ada data</td></tr>'}</table>`}
function pDash(){
 const L=flt(),sum=f=>L.reduce((s,x)=>s+(f(x)||0),0),kon=sum(x=>+x.p.kontrak),paid=sum(x=>x.c.paid),ph=L.filter(x=>x.c.phys!=null),
 avg=ph.length?ph.reduce((s,x)=>s+x.c.phys*(+x.p.kontrak||1),0)/ph.reduce((s,x)=>s+(+x.p.kontrak||1),0):null,
 n=s=>L.filter(x=>x.c.st===s).length;
 let sel=F.curve,cv=sel?(()=>{const x=L.find(y=>y.p.id===sel);if(!x)return curve(L);const W=Math.max(0,...Object.keys(x.c.plan).map(Number));return{W,P:[...Array(W)].map((_,i)=>x.c.pa(i+1)),R:[...Array(W)].map((_,i)=>x.c.lastW&&i+1<=x.c.lastW?x.c.ra(i+1):null)}})():curve(L);
 const lp=[...cv.P].reverse().find(v=>v!=null),lr=[...cv.R].reverse().find(v=>v!=null);
 return filters()+`<div class="grid">${card('Total Proyek',L.length)}${card('Total Pagu',rp(sum(x=>+x.p.pagu)))}${card('Total Nilai Kontrak',rp(kon))}${card('Rata-rata Progres Fisik',pc(avg),'terbobot nilai kontrak')}${card('Realisasi Keuangan',rp(paid))}${card('% Realisasi Keuangan',pc(kon?paid/kon*100:null),'dasar: nilai kontrak')}${card('Tepat Waktu',n('On Track')+n('Selesai'),'On Track + Selesai')}${card('Terlambat',n('Terlambat'),'Perlu perhatian: '+n('Perlu Perhatian'))}</div>
 <div class="two"><div class="card"><h2>Kurva S — Progres Fisik Kumulatif</h2><div class="row"><select onchange="F.curve=this.value;go()"><option value="">Seluruh proyek (agregat terbobot kontrak)</option>${L.map(x=>`<option value="${x.p.id}" ${x.p.id===F.curve?'selected':''}>${esc(x.p.nama.slice(0,50))}</option>`).join('')}</select></div>${cv.W?lineChart(cv.W,[{n:'Rencana',c:'#d93a3a',v:cv.P},{n:'Realisasi',c:'#1f5fd1',v:cv.R}]):'<div class="sub">Belum ada jadwal.</div>'}
 <div class="sub">Realisasi terakhir: <b>${pc(lr)}</b> · Target terakhir: <b>${pc(lp)}</b> · Deviasi: <b>${lr!=null&&lp!=null?(lr-lp).toFixed(1)+' poin':'–'}</b>. Minggu tanpa monitoring tidak dihitung nol.</div></div>
